# Copy to .env and adjust for your machine
MONGO_URI=mongodb://127.0.0.1:27017/database
PORT=3550

# Secret for signing login tokens: a random string of 32+ characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Admin user created by "npm run seed"
SEED_ADMIN_EMAIL=admin@efurniture.local
SEED_ADMIN_PASSWORD=

# ---- Optional ----

# How many days a login lasts (default 7)
# SESSION_DAYS=7

# Cookie SameSite: lax (default) when the client and API share a site
# (localhost, or app.example.com + api.example.com); none if they are on
# different sites, which forces Secure and needs HTTPS
# COOKIE_SAMESITE=lax

# Rate limits per IP: failed logins per 15 minutes, sign-ups per hour
# LOGIN_RATE_LIMIT=10
# REGISTER_RATE_LIMIT=10

# Number of proxies in front of the API, e.g. 1 on Render (so rate limits
# see the real client IP)
# TRUST_PROXY=1

# bcrypt cost factor (default 12)
# BCRYPT_ROUNDS=12
